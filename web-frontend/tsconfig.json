{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Path Aliases — all point into src/ */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    // QUARANTINED: these two components are unwired (imported nowhere) and depend
    // on three utility modules that were never implemented
    // (@/lib/utils/encryption, @/lib/utils/headers, @/lib/utils/validation).
    // They are excluded so type-check covers all live code. See FIXES.md
    // (frontend). Remove these entries once the missing modules are implemented.
    "src/components/features/security/SecureForm.tsx",
    "src/components/features/security/EncryptedDisplay.tsx"
  ]
}
